# Copy to .env and fill in. Everything is optional — a service without keys shows "not configured" in the app.

# --- Server ---
WW_PUBLIC_URL=http://localhost:8000      # used in email links, share links and the agent pairing command
WW_SECRET_KEY=                           # signs sessions/share links; auto-generated into data/ when empty
WW_DATA_DIR=                             # default: ./data
WW_DATA_REGION=Local machine (deploy to AWS ap-south-1 Mumbai for India residency)

# --- CV pipeline ---
# yolov8n.pt is fastest; yolov8s.pt / yolov8m.pt find small, crouched or partly hidden people better.
WW_MODEL=yolov8s.pt
WW_POSE_MODEL=yolov8n-pose.pt            # confirms phone use (phone near wrist/ear)
WW_DET_CONF=0.25
WW_PHONE_CONF=0.25
WW_IMGSZ=640
# Frames analysed per second of video. 5-8 is plenty for working-time accounting.
WW_SAMPLE_FPS=8
# cpu | mps (Apple Silicon GPU) | cuda:0   (empty = auto)
WW_DEVICE=

# --- Job queue ---
WW_INPROCESS_WORKER=1                    # 0 when separate GPU workers process the queue
WW_WORKERS=1                             # in-process worker threads
WW_WORKER_TOKEN=                         # shared secret for `python -m workwatch worker --server ... --token ...`

# --- Review flags ---
WW_MIN_SEGMENT_S=3
WW_LOW_CONF=0.45
WW_SHORT_TRACK_S=8

# --- Email (any SMTP: Gmail app password, SES, SendGrid, Mailgun, Office365...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
MANAGER_EMAILS=

# --- WhatsApp report delivery: meta | gupshup | interakt ---
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=                          # Meta access token / Gupshup apikey / Interakt API key
WHATSAPP_PHONE_ID=                       # Meta phone-number id
WHATSAPP_SOURCE=                         # Gupshup source number
WHATSAPP_APP=                            # Gupshup app name

# --- Mobile OTP login: msg91 | twilio ---
SMS_PROVIDER=
SMS_KEY=                                 # MSG91 authkey / Twilio "SID:TOKEN"
SMS_SENDER=                              # MSG91 template id / Twilio from-number

# --- Google sign-in (OAuth client, redirect URI = WW_PUBLIC_URL/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (Razorpay, INR + 18% GST) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Daily automation inside the server process (HH:MM, 24h local time). Empty = off; use cron instead. ---
WW_DAILY_RUN_AT=19:00
# Which day's footage the daily report covers: today | yesterday
WW_DAILY_REPORT_DAY=today
