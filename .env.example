# Copy to .env and fill in. Everything is optional.

# --- Pipeline ---
# yolov8n.pt is fastest; yolov8s.pt / yolov8m.pt find small, crouched or partly hidden people better.
WW_MODEL=yolov8s.pt
WW_DET_CONF=0.25
# Frames analysed per second of video. 5-8 is plenty for working-time accounting.
WW_SAMPLE_FPS=8
# cpu | mps (Apple Silicon GPU) | cuda:0   (empty = auto)
WW_DEVICE=

# --- Review flags ---
WW_MIN_SEGMENT_S=3
WW_LOW_CONF=0.45
WW_SHORT_TRACK_S=8

# --- Email delivery (any SMTP server: Gmail app password, SES, SendGrid, Mailgun, Office365...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
MANAGER_EMAILS=manager@company.com

# --- Daily automation inside the server process (HH:MM, 24h local time). Empty = off; use cron instead. ---
WW_DAILY_RUN_AT=19:00
# Which day's footage the daily report covers: today | yesterday
WW_DAILY_REPORT_DAY=today
